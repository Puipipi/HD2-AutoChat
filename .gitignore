# Build output: not source. The ZIP is produced by work/standalone/build_mod.py
# and published as a release asset instead of being committed.
dist/

# The Bingus loader's envelope-packaging tool is a BUILD DEPENDENCY, not ours to
# redistribute (see THIRD_PARTY_NOTICES.md). Keeping it out of the index is the
# whole point of that notice.
work/standalone/vendor/

# Runtime and temporary files
*.log
*.tmp
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

# One-shot local scratch
work/scratch/
*.bak
*.bak-*

# Machine-specific deployment state. The pre-install BASELINE files beside it are
# evidence and stay tracked.
work/deploy/deployed.json

# Local rollback packages and machine-specific verification snapshots.
# Reproducible source, documentation and test logs remain in Git; installable
# packages are backed up as GitHub Release assets.
work/deploy/backup-*.patch_*
work/deploy/manager-backup-*.zip
work/deploy/preflight-*.json
work/deploy/verification-*.json

# One-off commit-message drafts
work/deploy/cmsg*.txt
work/deploy/_m.txt
